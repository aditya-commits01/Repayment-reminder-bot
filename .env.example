# Copy this file to .env and fill in your values. Never commit .env to git.

DB_PATH=reminders.db
COMPANY_NAME=Credex
CURRENCY_SYMBOL=Rs.

# SMTP settings (only needed for `run --send`)
# Gmail example: smtp.gmail.com / 587 / use an App Password, not your login password
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-username
SMTP_PASSWORD=your-password-or-app-password
SMTP_USE_TLS=true
FROM_EMAIL=reminders@example.com
